.ProseMirror { overflow-wrap: break-word; white-space: break-spaces; font-v=
ariant-ligatures: none; font-feature-settings: "liga" 0; position: relative=
; }

.ProseMirror pre { white-space: pre-wrap; }

.ProseMirror li { position: relative; }

.ProseMirror-hideselection ::selection { background: 0px 0px; }

.ProseMirror-hideselection { caret-color: rgba(0, 0, 0, 0); }

.ProseMirror [draggable][contenteditable=3D"false"] { user-select: text; }

.ProseMirror-selectednode { outline: rgb(136, 204, 255) solid 2px; }

li.ProseMirror-selectednode { outline: none; }

li.ProseMirror-selectednode::after { content: ""; pointer-events: none; bor=
der: 2px solid rgb(136, 204, 255); position: absolute; inset: -2px -2px -2p=
x -32px; }

img.ProseMirror-separator { border-width: medium !important; border-style: =
