  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes daybreak-glow {=20
  0%, 100% { opacity: 0; }
  5.976%, 62.35% { opacity: var(--daybreak-peak-opacity); }
}

@keyframes daybreak-tint {=20
  5.976%, 62.35% { color: rgb(43, 26, 4); }
}

@keyframes daybreak-sweep {=20
  0% { mask-position: 85% 0px; }
  100% { mask-position: 15% 0px; }
}

@keyframes daybreak-rise {=20
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes daybreak-turn {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(180deg); }
}

@keyframes daybreak-sink {=20
  0% { opacity: 1; transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(var(--daybreak-sink-distance,8px=
)); }
}

@keyframes daybreak-reduced-glow {=20
  0%, 100% { opacity: 0; }
  25%, 40% { opacity: var(--daybreak-peak-opacity); }
}

@keyframes daybreak-reduced-tint {=20
  25%, 40% { color: rgb(43, 26, 4); }
}

