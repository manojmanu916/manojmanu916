[data-inline-mention-selected] { background-color: var(--color-background-t=
ext-selection); }

[data-inline-mention-selected][data-appearance] { background-color: var(--c=
olor-background-text-selection); border-radius: 0px; }

[data-inline-mention-selected][data-layout=3D"inline-flow"]:not([data-appea=
rance=3D"pill"]) { padding-block: var(--inline-mention-selection-padding,ca=
lc(var(--spacing) * .5)); }

[data-inline-mention-selected]::selection, [data-inline-mention-selected] :=
:selection, [data-page-selection-hide-native] [data-inline-mention-selected=
], .ProseMirror-hideselection [data-inline-mention-selected], .ProseMirror-=
focused [data-composer-inline-atom-selected] [data-inline-mention-selected]=
 { background-color: rgba(0, 0, 0, 0); }

.ProseMirror .placeholder { pointer-events: none; user-select: none; positi=
on: relative; }

.ProseMirror .placeholder::before { content: attr(data-placeholder); pointe=
r-events: none; user-select: none; white-space: nowrap; text-overflow: elli=
psis; max-width: 100%; position: absolute; inset: 0px 0px auto; overflow: h=
idden; }

[data-composer-input-variant=3D"form"] .ProseMirror .placeholder { display:=
 flow-root; }

[data-composer-input-variant=3D"form"] .ProseMirror .placeholder::before { =
float: inline-start; white-space: normal; overflow-wrap: anywhere; width: 1=
00%; margin-inline-end: -100%; position: static; }

.ProseMirror .placeholder::selection, .ProseMirror .placeholder ::selection=
 { color: inherit; background: 0px 0px; }

.ProseMirror .ProseMirror-selectednode:has([skill-mention-name]) { outline:=
 none; }

code, pre { font-family: var(--font-mono) !important; }

code[class=3D"language-plaintext"] { white-space: pre-line; }

code[class*=3D"language-"], pre[class*=3D"language-"], code.hljs { text-ali=
gn: left; white-space: pre; word-spacing: normal; word-break: normal; overf=
low-wrap: normal; tab-size: 4; hyphens: none; background: 0px 0px; line-hei=
ght: 1.5; }

pre[class*=3D"language-"] { border-radius: 0.3em; overflow: auto; }

:not(pre) > code[class*=3D"language-"], :not(pre) > code.hljs { white-space=
: normal; border-radius: 0.3em; padding: 0.1em; }

.hljs-comment, .hljs-quote { color: var(--color-codex-syntax-comment); font=
-style: italic; }

.hljs-doctag, .hljs-keyword, .hljs-formula, .hljs-operator { color: var(--c=
olor-codex-syntax-keyword); }

.hljs-built_in, .hljs-class .hljs-title, .hljs-literal, .hljs-number { colo=
r: var(--color-codex-syntax-literal); }

.hljs-string, .hljs-regexp, .hljs-addition, .hljs-meta-string { color: var(=
--color-codex-syntax-string); }

.hljs-variable, .hljs-template-variable, .hljs-type, .hljs-title, .hljs-sel=
ector-class, .hljs-selector-pseudo { color: var(--color-codex-syntax-variab=
le); }

.hljs-attr, .hljs-attribute, .hljs-section, .hljs-selector-attr { color: va=
r(--color-codex-syntax-attribute); }

.hljs-name, .hljs-selector-tag, .hljs-symbol, .hljs-bullet, .hljs-link, .hl=
js-meta, .hljs-selector-id { color: var(--color-codex-syntax-name); }

.hljs-deletion { color: var(--color-codex-syntax-error); }

.hljs-emphasis { font-style: italic; }

.hljs-strong { font-weight: 700; }

.hljs-link { text-decoration: underline; }
