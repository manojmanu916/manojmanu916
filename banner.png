  .scroll-contain { overscroll-behavior: contain; overflow: auto; }
  .disambig-digits.slashed-zero { font-feature-settings: "ss06"; }
  [data-composer-attachments][data-composer-spacing=3D"default"]:not([data-=
composer-inline]) .composer-attachment-surface { border-radius: var(--compo=
ser-attachment-border-radius); }
  .h-token-button-composer, .h-token-button-composer-sm { gap: var(--h-toke=
n-button-composer-gap); }
  .overflow-auto, .overflow-scroll, .overflow-x-auto, .overflow-y-auto, .ov=
erflow-x-scroll, .overflow-y-scroll, :where(.messaging-root) .messages-scro=
ll { scrollbar-color: var(--color-border) transparent; }
  :is(.overflow-auto, .overflow-scroll, .overflow-x-auto, .overflow-y-auto,=
 .overflow-x-scroll, .overflow-y-scroll, :where(.messaging-root) .messages-=
scroll):hover, :is(.overflow-auto, .overflow-scroll, .overflow-x-auto, .ove=
rflow-y-auto, .overflow-x-scroll, .overflow-y-scroll, :where(.messaging-roo=
t) .messages-scroll):active { scrollbar-color: var(--color-border-strong) t=
ransparent; }
  @media (prefers-contrast: more) {
  :is(.overflow-auto, .overflow-scroll, .overflow-x-auto, .overflow-y-auto,=
 .overflow-x-scroll, .overflow-y-scroll, :where(.messaging-root) .messages-=
scroll), :is(.overflow-auto, .overflow-scroll, .overflow-x-auto, .overflow-=
y-auto, .overflow-x-scroll, .overflow-y-scroll, :where(.messaging-root) .me=
ssages-scroll):hover, :is(.overflow-auto, .overflow-scroll, .overflow-x-aut=
o, .overflow-y-auto, .overflow-x-scroll, .overflow-y-scroll, :where(.messag=
ing-root) .messages-scroll):active { scrollbar-color: canvastext canvas; }
}
  .rich-text-user-turn blockquote { margin-block: calc(var(--markdown-space=
,var(--spacing)) * 4) !important; }
  .rich-text-user-turn > blockquote:first-child, .rich-text-user-turn block=
quote > blockquote:first-child, .rich-text-user-turn [data-starts-with-bloc=
kquote] > blockquote:first-of-type { margin-block-start: 0px !important; }
  .rich-text-user-turn > blockquote:last-child, .rich-text-user-turn blockq=
uote > blockquote:last-child, .rich-text-user-turn [data-ends-with-blockquo=
te] > blockquote:last-of-type, .rich-text-user-turn [data-markdown-list-ite=
m-content] > :last-child:not(blockquote, h1, h2, h3) { margin-block-end: 0p=
x !important; }
  .rich-text-user-turn > :is(p, ul, ol) + :is(ul, ol), .rich-text-user-turn=
 > :is(ul, ol) + p { margin-block-start: calc(var(--markdown-space,var(--sp=
acing)) * 4) !important; }
  .rich-text-user-turn :is(ul, ol) > li, .rich-text-user-turn :is(li, block=
quote, [data-markdown-list-item-content]) > p { margin-block: 0px !importan=
t; }
  .rich-text-user-turn :is(li, blockquote, [data-markdown-list-item-content=
]) > :is(p, ul, ol, blockquote) + :is(p, ul, ol, blockquote) { margin-block=
-start: calc(var(--markdown-space,var(--spacing)) * 4) !important; }
  .rich-text-user-turn li:has(> p, > [data-markdown-list-item-content] > p)=
 + li { margin-block-start: calc(var(--markdown-space,var(--spacing)) * 4) =
!important; }
}

@property --left-fade { syntax: "<length>"; inherits: false; initial-value:=
 0; }

@property --right-fade { syntax: "<length>"; inherits: false; initial-value=
: 0; }

@keyframes edge-fade-horizontal {=20
  0% { --left-fade: 0; --right-fade: var(--edge-fade-distance,1rem); }
  0.1%, 99.9% { --left-fade: var(--edge-fade-distance,1rem); --right-fade: =
var(--edge-fade-distance,1rem); }
  100% { --left-fade: var(--edge-fade-distance,1rem); --right-fade: 0; }
}

